#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";
//&kp ESC       &kp N1        &kp N2        &kp N3        &kp N4        &kp N5    &none                   &none   &kp N6        &kp N7        &kp N8        &kp N9        &kp N0        &kp MINUS
//&kp TAB       &kp Q         &kp W         &kp E         &kp R         &kp T     &none                   &none   &kp Y         &kp U         &kp I         &kp O         &kp P         &kp BSLH
        default_layer {
            bindings = <
&kp ESC       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none               &none   &kp N6        &kp N7        &kp N8        &kp N9        &kp N0        &kp MINUS
&kp TAB       &out OUT_USB &out OUT_BLE   &kp E         &kp R         &bt BT_CLR    &sys_reset          &none   &kp Y         &kp U         &kp I         &kp O         &kp P         &kp BSLH
&kp CAPS      &kp A         &kp S         &kp D         &kp F         &kp G     &none                   &none   &kp H         &kp J         &kp K         &kp L         &kp SEMI      &kp SQT
&kp LSHFT     &kp Z         &kp X         &kp C         &kp V         &kp B                                     &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH      &kp RSHFT
&none         &kp GRAVE     &kp BSLH      &kp LEFT      &kp RIGHT                                                             &kp DOWN      &kp UP        &kp LBKT      &kp RBKT      &none
                                                                      &kp EQUAL     &kp MINUS   &kp LBKT      &kp RBKT
                                                                                    &kp GRAVE   &kp BSPC
                                                        &kp LCTRL     &kp LALT      &kp LGUI    &kp DEL       &kp RETURN       &kp SPACE
            >;
        };
    };
};
