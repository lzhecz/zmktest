// dactyl_cc_right.overlay

#include "dactyl_cc.dtsi"

&default_transform { // The matrix transform for this board is 6 columns over because the left half is 6 columns wide according to the matrix.
    col-offset = <7>;
};

&kscan0 {
        col-gpios
            = <&pro_micro 3 GPIO_ACTIVE_HIGH>   // P0_09 = D3
            , <&pro_micro 4 GPIO_ACTIVE_HIGH>   // P0_10 = D4
            , <&pro_micro 6 GPIO_ACTIVE_HIGH>   // P1_11 = D6
            , <&pro_micro 7 GPIO_ACTIVE_HIGH>   // P1_13 = D7
            , <&pro_micro 8 GPIO_ACTIVE_HIGH>   // P1_15 = D8
            , <&pro_micro 1 GPIO_ACTIVE_HIGH>   // P0_02 = D1
            , <&pro_micro 2 GPIO_ACTIVE_HIGH>   // P0_29 = D2
            ;
};
